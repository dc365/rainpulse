# Optional build-time XYZ basemap. The default is public OpenStreetMap.
# For formal deployment, point this at the approved internal tile service.
VITE_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_BASEMAP_LABEL=OPENSTREETMAP
VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap 贡献者
# Optional annotation tiles stacked over the basemap (same XYZ template).
# Recommended: the server-side proxy keeps the Tianditu token off clients and
# works on browsers without direct internet egress. Set the token on the
# control plane via RAINPULSE_TIANDITU_TOKEN, then in .env.local (gitignored):
#   VITE_BASEMAP_URL='/api/v1/workspace/basemap-tiles/vec/{z}/{x}/{y}.png'
#   VITE_BASEMAP_OVERLAY_URL='/api/v1/workspace/basemap-tiles/cva/{z}/{x}/{y}.png'
# Direct Tianditu access (client needs internet + CORS) would look like:
#   VITE_BASEMAP_URL='https://t{0-7}.tianditu.gov.cn/DataServer?T=vec_w&x={x}&y={y}&l={z}&tk=YOUR_TOKEN'
VITE_BASEMAP_OVERLAY_URL=
