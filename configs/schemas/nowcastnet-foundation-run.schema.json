{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.internal/schemas/nowcastnet-foundation-run.schema.json",
  "title": "RainPulse NowcastNet MRMS foundation training run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "lifecycle", "operational_eligible", "frozen_inputs", "sequence", "data_tracks", "evolution", "optimization", "data_loading", "checkpoint", "reproducibility"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_version": {"const": "nowcastnet-mrms-foundation-v1"},
    "lifecycle": {"const": "offline_training"},
    "operational_eligible": {"const": false},
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_profile", "full_sample_profile", "full_sample_library_evidence"],
      "properties": {
        "training_profile": {"$ref": "#/$defs/pathHash"},
        "full_sample_profile": {"$ref": "#/$defs/pathHash"},
        "full_sample_library_evidence": {"$ref": "#/$defs/pathHash"}
      }
    },
    "sequence": {"$ref": "#/$defs/sequence"},
    "data_tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation_0p01", "paper_conformance_0p02"],
      "properties": {
        "foundation_0p01": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "data_root_env", "dataset_contract", "expected_dataset_version", "expected_profile_sha256", "expected_plan_id", "require_validation_report", "crs", "source_resolution_deg", "resolution_deg", "native_crop_size", "model_crop_size", "downsample_method", "expected_sample_count", "expected_shard_count"],
          "properties": {
            "purpose": {"const": "rainpulse_foundation_training"},
            "data_root_env": {"const": "RAINPULSE_MRMS_FULL_ROOT"},
            "dataset_contract": {"const": "full_sample_v1"},
            "expected_dataset_version": {"const": "nowcastnet-mrms-full-samples-v1"},
            "expected_profile_sha256": {"const": "c84c76c399c9a0d74f94dea608bc4030e71b482a5247fc821fc7e245fe034be5"},
            "expected_plan_id": {"const": "5ce3859f8f914c9cd55ea92a96a5dd860d46e297fff229472843d21e0bc26892"},
            "require_validation_report": {"const": true},
            "crs": {"const": "EPSG:4326"},
            "source_resolution_deg": {"const": 0.01},
            "resolution_deg": {"const": 0.01},
            "native_crop_size": {"const": 256},
            "model_crop_size": {"const": 256},
            "downsample_method": {"const": "none"},
            "expected_sample_count": {"const": 100000},
            "expected_shard_count": {"const": 4000}
          }
        },
        "paper_conformance_0p02": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "data_root_env", "dataset_contract", "crs", "source_resolution_deg", "resolution_deg", "native_crop_size", "model_crop_size", "downsample_method", "downsample_rule_provenance", "official_kernel_published", "expected_sample_count", "expected_shard_count"],
          "properties": {
            "purpose": {"const": "trainer_protocol_conformance_only"},
            "data_root_env": {"const": "RAINPULSE_MRMS_CONFORMANCE_ROOT"},
            "dataset_contract": {"const": "pilot_v1"},
            "crs": {"const": "EPSG:4326"},
            "source_resolution_deg": {"const": 0.01},
            "resolution_deg": {"const": 0.02},
            "native_crop_size": {"const": 512},
            "model_crop_size": {"const": 256},
            "downsample_method": {"const": "block_mean_2x2"},
            "downsample_rule_provenance": {"const": "rainpulse_conservative_area_mean"},
            "official_kernel_published": {"const": false},
            "expected_sample_count": {"const": 16},
            "expected_shard_count": {"const": 16}
          }
        }
      }
    },
    "evolution": {"$ref": "#/$defs/evolution"},
    "optimization": {"$ref": "#/$defs/optimization"},
    "data_loading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_count", "prefetch_factor", "persistent_workers", "pin_memory", "in_order", "batched_shard_reads"],
      "properties": {
        "worker_count": {"const": 4},
        "prefetch_factor": {"const": 2},
        "persistent_workers": {"const": true},
        "pin_memory": {"const": true},
        "in_order": {"const": true},
        "batched_shard_reads": {"const": true}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_interval_steps", "maximum_interval_seconds", "graceful_signals", "atomic_write_and_loadback"],
      "properties": {
        "maximum_interval_steps": {"const": 5000},
        "maximum_interval_seconds": {"const": 1800},
        "graceful_signals": {"const": ["SIGINT", "SIGTERM"]},
        "atomic_write_and_loadback": {"const": true}
      }
    },
    "reproducibility": {"$ref": "#/$defs/reproducibility"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_frames", "target_frames", "total_frames", "cadence_minutes", "rain_rate_cap_mm_h"],
      "properties": {"input_frames": {"const": 9}, "target_frames": {"const": 20}, "total_frames": {"const": 29}, "cadence_minutes": {"const": 10}, "rain_rate_cap_mm_h": {"const": 128.0}}
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_channels", "spectral_normalization", "interpolation_for_prediction", "interpolation_for_motion_gradient", "padding_mode", "stop_gradient_between_steps", "weighted_l1", "motion_regularization"],
      "properties": {
        "base_channels": {"const": 32}, "spectral_normalization": {"const": true}, "interpolation_for_prediction": {"const": "nearest"}, "interpolation_for_motion_gradient": {"const": "bilinear"}, "padding_mode": {"const": "border"}, "stop_gradient_between_steps": {"const": true},
        "weighted_l1": {"type": "object", "additionalProperties": false, "required": ["formula", "weight_cap"], "properties": {"formula": {"const": "min(24,1+target_mm_h)"}, "weight_cap": {"const": 24.0}}},
        "motion_regularization": {"type": "object", "additionalProperties": false, "required": ["operator", "lambda"], "properties": {"operator": {"const": "sobel"}, "lambda": {"const": 0.01}}}
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimizer", "global_batch_size", "initial_learning_rate", "decay_step", "decayed_learning_rate", "total_steps", "default_precision", "gradient_clip_norm"],
      "properties": {"optimizer": {"const": "Adam"}, "global_batch_size": {"const": 16}, "initial_learning_rate": {"const": 0.001}, "decay_step": {"const": 200000}, "decayed_learning_rate": {"const": 0.0001}, "total_steps": {"const": 300000}, "default_precision": {"const": "bf16"}, "gradient_clip_norm": {"const": 1.0}}
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_seed", "deterministic_sample_order", "checkpoint_after_complete_optimizer_step", "exact_resume_required"],
      "properties": {"run_seed": {"const": 2026083002}, "deterministic_sample_order": {"const": true}, "checkpoint_after_complete_optimizer_step": {"const": true}, "exact_resume_required": {"const": true}}
    }
  }
}
