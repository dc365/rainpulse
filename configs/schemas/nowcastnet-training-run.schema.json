{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.internal/schemas/nowcastnet-training-run.schema.json",
  "title": "RainPulse NowcastNet training run profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "lifecycle",
    "operational_eligible",
    "frozen_inputs",
    "sequence",
    "data_tracks",
    "evolution",
    "optimization",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_version": {"const": "nowcastnet-mrms-run-v1"},
    "lifecycle": {"const": "offline_training"},
    "operational_eligible": {"const": false},
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_profile", "pilot_profile", "pilot_evidence"],
      "properties": {
        "training_profile": {"$ref": "#/$defs/pathHash"},
        "pilot_profile": {"$ref": "#/$defs/pathHash"},
        "pilot_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "sample_index_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "sample_index_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_frames",
        "target_frames",
        "total_frames",
        "cadence_minutes",
        "rain_rate_cap_mm_h"
      ],
      "properties": {
        "input_frames": {"const": 9},
        "target_frames": {"const": 20},
        "total_frames": {"const": 29},
        "cadence_minutes": {"const": 10},
        "rain_rate_cap_mm_h": {"const": 128.0}
      }
    },
    "data_tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation_0p01", "paper_conformance_0p02"],
      "properties": {
        "foundation_0p01": {
          "allOf": [
            {"$ref": "#/$defs/dataTrack"},
            {
              "properties": {
                "purpose": {"const": "rainpulse_foundation_training"},
                "data_root_env": {"const": "RAINPULSE_MRMS_PILOT_ROOT"},
                "source_resolution_deg": {"const": 0.01},
                "resolution_deg": {"const": 0.01},
                "native_crop_size": {"const": 256},
                "model_crop_size": {"const": 256},
                "downsample_method": {"const": "none"},
                "expected_sample_count": {"const": 10000}
              }
            }
          ]
        },
        "paper_conformance_0p02": {
          "allOf": [
            {"$ref": "#/$defs/dataTrack"},
            {
              "required": ["downsample_rule_provenance", "official_kernel_published"],
              "properties": {
                "purpose": {"const": "trainer_protocol_conformance_only"},
                "data_root_env": {"const": "RAINPULSE_MRMS_CONFORMANCE_ROOT"},
                "source_resolution_deg": {"const": 0.01},
                "resolution_deg": {"const": 0.02},
                "native_crop_size": {"const": 512},
                "model_crop_size": {"const": 256},
                "downsample_method": {"const": "block_mean_2x2"},
                "downsample_rule_provenance": {
                  "const": "rainpulse_conservative_area_mean"
                },
                "official_kernel_published": {"const": false},
                "expected_sample_count": {"const": 16}
              }
            }
          ]
        }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_channels",
        "spectral_normalization",
        "interpolation_for_prediction",
        "interpolation_for_motion_gradient",
        "padding_mode",
        "stop_gradient_between_steps",
        "weighted_l1",
        "motion_regularization"
      ],
      "properties": {
        "base_channels": {"const": 32},
        "spectral_normalization": {"const": true},
        "interpolation_for_prediction": {"const": "nearest"},
        "interpolation_for_motion_gradient": {"const": "bilinear"},
        "padding_mode": {"const": "border"},
        "stop_gradient_between_steps": {"const": true},
        "weighted_l1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formula", "weight_cap"],
          "properties": {
            "formula": {"const": "min(24,1+target_mm_h)"},
            "weight_cap": {"const": 24.0}
          }
        },
        "motion_regularization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "lambda"],
          "properties": {
            "operator": {"const": "sobel"},
            "lambda": {"const": 0.01}
          }
        }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimizer",
        "global_batch_size",
        "initial_learning_rate",
        "decay_step",
        "decayed_learning_rate",
        "total_steps",
        "default_precision",
        "gradient_clip_norm"
      ],
      "properties": {
        "optimizer": {"const": "Adam"},
        "global_batch_size": {"const": 16},
        "initial_learning_rate": {"const": 0.001},
        "decay_step": {"const": 200000},
        "decayed_learning_rate": {"const": 0.0001},
        "total_steps": {"const": 300000},
        "default_precision": {"const": "bf16"},
        "gradient_clip_norm": {"const": 1.0}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_seed",
        "deterministic_sample_order",
        "checkpoint_after_complete_optimizer_step",
        "exact_resume_required"
      ],
      "properties": {
        "run_seed": {"const": 2026083002},
        "deterministic_sample_order": {"const": true},
        "checkpoint_after_complete_optimizer_step": {"const": true},
        "exact_resume_required": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "data_root_env",
        "crs",
        "source_resolution_deg",
        "resolution_deg",
        "native_crop_size",
        "model_crop_size",
        "downsample_method",
        "expected_sample_count"
      ],
      "properties": {
        "purpose": {"type": "string"},
        "data_root_env": {"type": "string"},
        "crs": {"const": "EPSG:4326"},
        "source_resolution_deg": {"type": "number"},
        "resolution_deg": {"type": "number"},
        "native_crop_size": {"type": "integer", "minimum": 16},
        "model_crop_size": {"type": "integer", "minimum": 16},
        "downsample_method": {"enum": ["none", "block_mean_2x2"]},
        "expected_sample_count": {"type": "integer", "minimum": 1},
        "downsample_rule_provenance": {"type": "string"},
        "official_kernel_published": {"type": "boolean"}
      }
    }
  }
}
