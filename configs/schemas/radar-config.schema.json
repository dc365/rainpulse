{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/configs/schemas/radar-config.schema.json",
  "title": "RainPulse radar configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "radar_id",
    "lifecycle",
    "site",
    "hardware",
    "scan",
    "fields",
    "source",
    "ancillary",
    "qc"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "config_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "radar_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "ready", "disabled"],
      "description": "Only ready configurations may ingest operational data."
    },
    "display_name": { "type": ["string", "null"], "minLength": 1 },
    "site": { "$ref": "#/$defs/site" },
    "hardware": { "$ref": "#/$defs/hardware" },
    "scan": { "$ref": "#/$defs/scan" },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldMapping" }
    },
    "source": { "$ref": "#/$defs/source" },
    "ancillary": { "$ref": "#/$defs/ancillary" },
    "qc": { "$ref": "#/$defs/qc" },
    "known_issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "inventory_owner": { "type": ["string", "null"], "minLength": 1 },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "lifecycle": { "const": "ready" } },
        "required": ["lifecycle"]
      },
      "then": {
        "properties": {
          "site": { "$ref": "#/$defs/readySite" },
          "hardware": { "$ref": "#/$defs/readyHardware" },
          "scan": { "$ref": "#/$defs/readyScan" },
          "fields": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/readyFieldMapping" },
            "contains": {
              "type": "object",
              "required": ["canonical_name"],
              "properties": { "canonical_name": { "const": "DBZH" } }
            }
          },
          "source": { "$ref": "#/$defs/readySource" },
          "ancillary": { "$ref": "#/$defs/readyAncillary" },
          "qc": { "$ref": "#/$defs/readyQc" }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude_deg", "latitude_deg", "altitude_m", "antenna_altitude_m", "altitude_datum"],
      "properties": {
        "longitude_deg": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "latitude_deg": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "altitude_m": { "type": ["number", "null"] },
        "antenna_altitude_m": { "type": ["number", "null"] },
        "altitude_datum": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "readySite": {
      "allOf": [
        { "$ref": "#/$defs/site" },
        {
          "properties": {
            "longitude_deg": { "type": "number" },
            "latitude_deg": { "type": "number" },
            "altitude_m": { "type": "number" },
            "antenna_altitude_m": { "type": "number" },
            "altitude_datum": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "radar_band",
        "frequency_mhz",
        "beam_width_deg",
        "beam_width_vertical_deg",
        "dual_pol_available",
        "nyquist_velocity_mps",
        "calibration_offsets"
      ],
      "properties": {
        "manufacturer": { "type": ["string", "null"], "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "radar_band": { "type": ["string", "null"], "enum": ["S", "C", "X", null] },
        "frequency_mhz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "beam_width_deg": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10 },
        "beam_width_vertical_deg": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10 },
        "dual_pol_available": { "type": ["boolean", "null"] },
        "nyquist_velocity_mps": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "calibration_offsets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dbzh_db", "zdr_db"],
          "properties": {
            "dbzh_db": { "type": ["number", "null"] },
            "zdr_db": { "type": ["number", "null"] }
          }
        }
      }
    },
    "readyHardware": {
      "allOf": [
        { "$ref": "#/$defs/hardware" },
        {
          "properties": {
            "manufacturer": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "radar_band": { "type": "string", "enum": ["S", "C", "X"] },
            "frequency_mhz": { "type": "number", "exclusiveMinimum": 0 },
            "beam_width_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "beam_width_vertical_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "dual_pol_available": { "type": "boolean" }
          }
        }
      ]
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_name",
        "expected_update_seconds",
        "expected_elevations_deg",
        "expected_cut_elevations_deg",
        "azimuth_resolution_deg",
        "range_gate_m",
        "max_range_m"
      ],
      "properties": {
        "strategy_name": { "type": ["string", "null"], "minLength": 1 },
        "expected_update_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "expected_elevations_deg": {
          "type": ["array", "null"],
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": -1, "maximum": 90 }
        },
        "expected_cut_elevations_deg": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": { "type": "number", "minimum": -1, "maximum": 90 }
        },
        "azimuth_resolution_deg": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10 },
        "range_gate_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_range_m": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "readyScan": {
      "allOf": [
        { "$ref": "#/$defs/scan" },
        {
          "properties": {
            "strategy_name": { "type": "string", "minLength": 1 },
            "expected_update_seconds": { "type": "integer", "minimum": 1 },
            "expected_elevations_deg": { "type": "array", "minItems": 1 },
            "expected_cut_elevations_deg": { "type": "array", "minItems": 1 },
            "azimuth_resolution_deg": { "type": "number", "exclusiveMinimum": 0 },
            "range_gate_m": { "type": "number", "exclusiveMinimum": 0 },
            "max_range_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "source_name", "source_unit", "canonical_unit", "missing_value", "scale_factor", "add_offset"],
      "properties": {
        "canonical_name": {
          "type": "string",
          "enum": ["DBZH", "ZDR", "RHOHV", "PHIDP", "VR", "SW", "SNR"]
        },
        "source_name": { "type": "string", "minLength": 1 },
        "source_unit": { "type": "string", "minLength": 1 },
        "canonical_unit": { "type": "string", "minLength": 1 },
        "missing_value": { "type": ["number", "string", "null"] },
        "scale_factor": { "type": ["number", "null"] },
        "add_offset": { "type": ["number", "null"] }
      }
    },
    "readyFieldMapping": {
      "allOf": [
        { "$ref": "#/$defs/fieldMapping" },
        {
          "properties": {
            "scale_factor": { "type": "number" },
            "add_offset": { "type": "number" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "delivery", "uri_pattern", "timestamp_timezone"],
      "properties": {
        "format": { "type": ["string", "null"], "minLength": 1 },
        "format_version": { "type": ["string", "null"], "minLength": 1 },
        "delivery": {
          "type": ["string", "null"],
          "enum": ["shared_directory", "http_callback", "object_store", "manual", null]
        },
        "uri_pattern": { "type": ["string", "null"], "minLength": 1 },
        "timestamp_timezone": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "readySource": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "properties": {
            "format": { "type": "string", "minLength": 1 },
            "format_version": { "type": "string", "minLength": 1 },
            "delivery": {
              "type": "string",
              "enum": ["shared_directory", "http_callback", "object_store", "manual"]
            },
            "uri_pattern": { "type": "string", "minLength": 1 },
            "timestamp_timezone": { "const": "UTC" }
          }
        }
      ]
    },
    "ancillary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dem_asset_version", "clutter_map_version", "coastline_asset_version"],
      "properties": {
        "dem_asset_version": { "type": ["string", "null"], "minLength": 1 },
        "clutter_map_version": { "type": ["string", "null"], "minLength": 1 },
        "coastline_asset_version": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "readyAncillary": {
      "allOf": [
        { "$ref": "#/$defs/ancillary" },
        {
          "properties": {
            "dem_asset_version": { "type": "string", "minLength": 1 },
            "coastline_asset_version": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "pipeline_version", "flag_definition_version"],
      "properties": {
        "profile": { "type": ["string", "null"], "minLength": 1 },
        "pipeline_version": { "type": ["string", "null"], "minLength": 1 },
        "flag_definition_version": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "readyQc": {
      "allOf": [
        { "$ref": "#/$defs/qc" },
        {
          "properties": {
            "profile": { "type": "string", "minLength": 1 },
            "pipeline_version": { "type": "string", "minLength": 1 },
            "flag_definition_version": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
