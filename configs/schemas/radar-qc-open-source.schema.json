        "max_textrhv": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "title": "Max Textrhv",
          "type": "number"
        },
        "min_rhv": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Rhv",
          "type": "number"
        },
        "object_threshold_dbz": {
          "default": 0.0,
          "title": "Object Threshold Dbz",
          "type": "number"
        },
        "small_object_gates": {
          "default": 10,
          "minimum": 1,
          "title": "Small Object Gates",
          "type": "integer"
        }
      },
      "title": "PyArtConfig",
      "type": "object"
    },
    "QualityConfig": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "const": "minimum",
          "default": "minimum",
          "title": "Aggregation",
          "type": "string"
        },
        "components": {
          "default": [
            "QI_METEO",
            "QI_INTERFERENCE"
          ],
          "items": {
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "low_quality_threshold": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Low Quality Threshold",
          "type": "number"
        },
        "quantitative_minimum": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Quantitative Minimum",
          "type": "number"
        },
        "suspect_quality": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Suspect Quality",
          "type": "number"
        },
        "incomplete_capability_quality": {
          "default": 0.7,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Incomplete Capability Quality",
          "type": "number"
        },
        "low_snr_quality": {
          "default": 0.3,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Low Snr Quality",
          "type": "number"
        },
        "unavailable_component_policy": {
          "const": "penalize_and_record",
          "default": "penalize_and_record",
          "title": "Unavailable Component Policy",
          "type": "string"
        }
      },
      "title": "QualityConfig",
      "type": "object"
    },
    "RFIConfig": {
      "additionalProperties": false,
