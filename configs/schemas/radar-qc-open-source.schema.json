  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "engine": {
      "const": "open_source",
      "default": "open_source",
      "title": "Engine",
      "type": "string"
    },
    "profile_version": {
      "default": "fujian-qc-opensource-v1",
      "title": "Profile Version",
      "type": "string"
    },
    "pipeline_version": {
      "default": "qc-opensource-1.0.0",
