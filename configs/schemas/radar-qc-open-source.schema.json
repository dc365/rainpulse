{
  "$defs": {
    "ClutterConfig": {
      "additionalProperties": false,
      "properties": {
        "asset_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Uri"
        },
        "asset_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Version"
        },
        "asset_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Sha256"
        },
        "flag_probability": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Flag Probability",
          "type": "number"
        }
      },
      "title": "ClutterConfig",
      "type": "object"
    },
    "ContextConfig": {
      "additionalProperties": false,
      "properties": {
        "max_temporal_scans": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Temporal Scans",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_age_seconds": {
          "default": 900,
          "exclusiveMinimum": 0,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "max_cross_offset_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Max Cross Offset Seconds",
          "type": "integer"
        },
        "past_only": {
          "const": true,
          "default": true,
          "title": "Past Only",
          "type": "boolean"
        },
        "echo_threshold_dbz": {
          "default": 10.0,
          "title": "Echo Threshold Dbz",
          "type": "number"
        },
        "strong_support": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Strong Support",
          "type": "number"
        }
      },
      "title": "ContextConfig",
      "type": "object"
    },
    "EchoConfig": {
      "additionalProperties": false,
      "properties": {
        "dbzh_valid_range_dbz": {
          "default": [
            -32.0,
            80.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dbzh Valid Range Dbz",
          "type": "array"
        },
        "no_rain_below_dbz": {
          "default": -10.0,
          "title": "No Rain Below Dbz",
          "type": "number"
        },
        "low_snr_db": {
          "default": 3.0,
          "title": "Low Snr Db",
          "type": "number"
        },
        "strong_echo_dbz": {
          "default": 35.0,
          "title": "Strong Echo Dbz",
          "type": "number"
        }
      },
      "title": "EchoConfig",
      "type": "object"
    },
    "GeometryConfig": {
      "additionalProperties": false,
      "properties": {
        "maximum_azimuth_gap_factor": {
          "default": 1.8,
          "exclusiveMinimum": 1,
          "maximum": 3,
          "title": "Maximum Azimuth Gap Factor",
          "type": "number"
        },
        "duplicate_tolerance_deg": {
          "default": 0.01,
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "title": "Duplicate Tolerance Deg",
          "type": "number"
        },
        "maximum_elevation_spread_deg": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Maximum Elevation Spread Deg",
          "type": "number"
        },
        "maximum_ray_count": {
          "default": 2400,
          "exclusiveMinimum": 0,
          "title": "Maximum Ray Count",
          "type": "integer"
        },
        "maximum_gate_count": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "title": "Maximum Gate Count",
          "type": "integer"
        },
        "phase_period_deg": {
          "default": 360.0,
          "exclusiveMinimum": 0,
          "title": "Phase Period Deg",
          "type": "number"
        }
      },
      "title": "GeometryConfig",
      "type": "object"
    },
    "HealthConfig": {
      "additionalProperties": false,
      "properties": {
        "reject_states": {
          "default": [
            "UNAVAILABLE"
          ],
          "items": {
            "type": "string"
          },
          "title": "Reject States",
          "type": "array"
        },
        "degraded_quality_multiplier": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Degraded Quality Multiplier",
          "type": "number"
        }
      },
      "title": "HealthConfig",
      "type": "object"
    },
    "PhaseConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "band": {
          "default": "S",
          "enum": [
            "S",
            "C",
            "X"
          ],
          "title": "Band",
          "type": "string"
        },
        "window_gates": {
          "default": 7,
          "maximum": 31,
          "minimum": 3,
          "title": "Window Gates",
          "type": "integer"
        },
        "minimum_segment_m": {
          "default": 5000.0,
          "exclusiveMinimum": 0,
          "title": "Minimum Segment M",
          "type": "number"
        },
        "minimum_rhohv": {
          "default": 0.9,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Minimum Rhohv",
          "type": "number"
        },
        "niter": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Niter",
          "type": "integer"
        },
        "attenuation_enabled": {
          "default": false,
          "title": "Attenuation Enabled",
          "type": "boolean"
        },
        "maximum_correction_db": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Maximum Correction Db",
          "type": "number"
        }
      },
      "title": "PhaseConfig",
      "type": "object"
    },
    "PyArtConfig": {
      "additionalProperties": false,
      "properties": {
        "texture_window_m": {
          "default": 1750.0,
          "exclusiveMinimum": 0,
          "title": "Texture Window M",
          "type": "number"
        },
        "max_textrefl": {
          "default": 8.0,
          "exclusiveMinimum": 0,
          "title": "Max Textrefl",
          "type": "number"
        },
        "max_textzdr": {
          "default": 2.85,
          "exclusiveMinimum": 0,
          "title": "Max Textzdr",
          "type": "number"
