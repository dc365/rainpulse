{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/configs/schemas/radar-qc.schema.json",
  "title": "RainPulse basic polar radar QC profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "pipeline_version",
    "flag_definition_version",
    "health_gate",
    "echo",
    "radial_interference",
    "static_ground_clutter",
    "sea_ap",
    "quality_index"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_version": { "$ref": "#/$defs/version" },
    "pipeline_version": { "$ref": "#/$defs/version" },
    "flag_definition_version": { "$ref": "#/$defs/version" },
    "health_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reject_states", "degraded_quality_multiplier"],
      "properties": {
        "reject_states": {
          "type": "array",
          "items": { "enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE"] },
          "uniqueItems": true
        },
        "degraded_quality_multiplier": { "$ref": "#/$defs/probability" }
      }
    },
    "echo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dbzh_valid_range_dbz",
        "no_rain_below_dbz",
        "low_snr_db",
        "snr_meteo_range_db",
        "rhohv_meteo_range",
        "fallback_meteo_probability"
      ],
      "properties": {
        "dbzh_valid_range_dbz": { "$ref": "#/$defs/pair" },
        "no_rain_below_dbz": { "type": "number" },
        "low_snr_db": { "type": "number" },
        "snr_meteo_range_db": { "$ref": "#/$defs/pair" },
        "rhohv_meteo_range": { "$ref": "#/$defs/pair" },
        "fallback_meteo_probability": { "$ref": "#/$defs/probability" }
      }
    },
    "dual_pol_fuzzy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "zdr_plausible_range_db",
        "zdr_transition_db",
        "phidp_step_range_deg",
        "weights"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["diagnostic_only", "quality_index"] },
        "zdr_plausible_range_db": { "$ref": "#/$defs/pair" },
        "zdr_transition_db": { "type": "number", "exclusiveMinimum": 0 },
        "phidp_step_range_deg": { "$ref": "#/$defs/pair" },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rhohv", "snr", "zdr", "phidp"],
          "properties": {
            "rhohv": { "type": "number", "minimum": 0 },
            "snr": { "type": "number", "minimum": 0 },
            "zdr": { "type": "number", "minimum": 0 },
            "phidp": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "vertical_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "minimum_dbzh",
        "support_tolerance_db",
        "maximum_range_m"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["diagnostic_only", "radial_evidence"] },
        "minimum_dbzh": { "type": "number" },
        "support_tolerance_db": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_range_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "radial_interference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_valid_gate_fraction",
        "minimum_consecutive_gates",
        "neighbour_difference_db",
        "low_quality_probability",
        "flag_probability"
      ],
      "properties": {
        "minimum_valid_gate_fraction": { "$ref": "#/$defs/probability" },
        "minimum_consecutive_gates": { "type": "integer", "minimum": 2 },
        "neighbour_difference_db": { "type": "number", "exclusiveMinimum": 0 },
        "low_quality_probability": { "$ref": "#/$defs/probability" },
        "flag_probability": { "$ref": "#/$defs/probability" },
        "morphology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "mode",
            "candidate_difference_db",
            "minimum_segment_gates",
            "intermittent_minimum_segments",
            "short_range_max_m",
            "reverse_minimum_drop_db",
            "diagnostic_probability"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["diagnostic_only", "quality_index"] },
            "candidate_difference_db": { "type": "number", "exclusiveMinimum": 0 },
            "minimum_segment_gates": { "type": "integer", "minimum": 2 },
            "intermittent_minimum_segments": { "type": "integer", "minimum": 2 },
            "short_range_max_m": { "type": "number", "exclusiveMinimum": 0 },
            "reverse_minimum_drop_db": { "type": "number", "exclusiveMinimum": 0 },
            "diagnostic_probability": { "$ref": "#/$defs/probability" },
            "fan_closure": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "maximum_gap_rays",
                "minimum_valid_gate_fraction",
                "minimum_high_dbzh",
                "minimum_high_gate_fraction",
                "minimum_high_run",
                "minimum_range_growth_db"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "extent_gap_enabled": { "type": "boolean" },
                "edge_extension_enabled": { "type": "boolean" },
                "maximum_gap_rays": { "type": "integer", "minimum": 1 },
                "maximum_edge_rays": { "type": "integer", "minimum": 1 },
                "minimum_valid_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_high_dbzh": { "type": "number" },
                "minimum_high_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_edge_high_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_high_run": { "type": "integer", "minimum": 2 },
                "minimum_range_growth_db": { "type": "number", "exclusiveMinimum": 0 },
                "minimum_gap_valid_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_gap_consecutive_gates": { "type": "integer", "minimum": 2 },
                "minimum_gap_range_extent_fraction": { "$ref": "#/$defs/probability" },
                "minimum_gap_boundary_extent_ratio": { "$ref": "#/$defs/probability" },
                "minimum_edge_valid_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_edge_range_extent_fraction": { "$ref": "#/$defs/probability" },
                "minimum_edge_boundary_extent_ratio": { "$ref": "#/$defs/probability" },
                "minimum_seed_fraction": { "$ref": "#/$defs/probability" }
              }
            },
            "radial_extent_promotion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "minimum_valid_gate_fraction",
                "diagnostic_minimum_valid_gate_fraction",
                "minimum_consecutive_gates",
                "minimum_range_extent_fraction",
                "minimum_range_growth_db",
                "minimum_analysis_range_m",
                "maximum_power_iqr_db",
                "minimum_group_rays",
                "maximum_group_rays",
                "maximum_group_gap_rays",
                "maximum_hard_seed_distance_rays",
                "maximum_higher_elevation_extent_fraction"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "minimum_valid_gate_fraction": { "$ref": "#/$defs/probability" },
                "diagnostic_minimum_valid_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_consecutive_gates": { "type": "integer", "minimum": 2 },
                "minimum_range_extent_fraction": { "$ref": "#/$defs/probability" },
                "minimum_range_growth_db": { "type": "number", "exclusiveMinimum": 0 },
                "minimum_analysis_range_m": { "type": "number", "exclusiveMinimum": 0 },
                "maximum_power_iqr_db": { "type": "number", "exclusiveMinimum": 0 },
                "minimum_group_rays": { "type": "integer", "minimum": 2 },
                "maximum_group_rays": { "type": "integer", "minimum": 2 },
                "maximum_group_gap_rays": { "type": "integer", "minimum": 0 },
                "maximum_hard_seed_distance_rays": { "type": "integer", "minimum": 1 },
                "maximum_higher_elevation_extent_fraction": { "$ref": "#/$defs/probability" }
              }
            },
            "context_fusion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "minimum_independent_evidence",
                "minimum_temporal_context_scans",
                "maximum_temporal_context_scans",
                "temporal_persistence_threshold",
                "cross_radar_max_time_offset_seconds",
                "cross_radar_echo_threshold_dbzh",
                "minimum_cross_radar_overlap_gates",
                "cross_radar_promotion_max_consistency",
                "cross_radar_veto_min_consistency"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "minimum_independent_evidence": { "type": "integer", "minimum": 2, "maximum": 4 },
                "minimum_temporal_context_scans": { "type": "integer", "minimum": 2, "maximum": 3 },
                "maximum_temporal_context_scans": { "type": "integer", "minimum": 2, "maximum": 3 },
                "temporal_persistence_threshold": { "$ref": "#/$defs/probability" },
                "cross_radar_max_time_offset_seconds": { "type": "integer", "minimum": 1 },
                "cross_radar_echo_threshold_dbzh": { "type": "number" },
                "minimum_cross_radar_overlap_gates": { "type": "integer", "minimum": 1 },
                "cross_radar_promotion_max_consistency": { "$ref": "#/$defs/probability" },
                "cross_radar_veto_min_consistency": { "$ref": "#/$defs/probability" }
              }
            },
            "multiscale_promotion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "echo_threshold_dbzh",
                "short_window_rays",
                "long_window_rays",
                "minimum_score_gate_fraction",
                "minimum_edge_jump_gate_fraction",
                "minimum_diagnostic_gates",
                "minimum_high_dbzh",
                "minimum_high_gates",
                "minimum_range_growth_db"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "echo_threshold_dbzh": { "type": "number" },
                "short_window_rays": { "type": "integer", "minimum": 1 },
                "long_window_rays": { "type": "integer", "minimum": 2 },
                "minimum_score_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_edge_jump_gate_fraction": { "$ref": "#/$defs/probability" },
                "minimum_diagnostic_gates": { "type": "integer", "minimum": 2 },
                "minimum_high_dbzh": { "type": "number" },
                "minimum_high_gates": { "type": "integer", "minimum": 2 },
                "minimum_range_growth_db": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    },
    "static_ground_clutter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_uri", "asset_version", "flag_probability"],
      "properties": {
        "asset_uri": { "$ref": "#/$defs/asset_uri" },
        "asset_version": { "type": ["string", "null"] },
        "flag_probability": { "$ref": "#/$defs/probability" }
      }
    },
    "sea_ap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coastline_asset_uri", "asset_version", "flag_probability"],
      "properties": {
        "coastline_asset_uri": { "$ref": "#/$defs/asset_uri" },
        "asset_version": { "type": ["string", "null"] },
        "flag_probability": { "$ref": "#/$defs/probability" }
      }
    },
    "quality_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "components",
        "minimum_range_quality",
        "low_quality_threshold",
        "unavailable_component_policy"
      ],
      "properties": {
        "aggregation": { "const": "product" },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["QI_METEO", "QI_INTERFERENCE", "QI_RANGE"]
          }
        },
        "minimum_range_quality": { "$ref": "#/$defs/probability" },
        "low_quality_threshold": { "$ref": "#/$defs/probability" },
        "unavailable_component_policy": { "const": "skip_and_record" }
      }
    }
  },
  "$defs": {
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "asset_uri": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(file|s3)://" }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "pair": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
