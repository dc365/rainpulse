{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/analysis-diagnostics-requested.schema.json",
  "title": "analysis.diagnostics.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "run_id", "job_id", "trace_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "analysis.diagnostics.requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id", "analysis_time", "grid_id", "input_uri", "radar_inputs", "output_prefix", "diagnostic_config_version", "renderer_version", "flag_definition_version"],
      "properties": {
        "analysis_id": { "type": "string", "format": "uuid" },
        "analysis_time": { "type": "string", "format": "date-time" },
        "grid_id": { "type": "string", "minLength": 1 },
        "input_uri": { "type": "string", "format": "uri" },
        "radar_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["radar_id", "scan_id", "qc_uri"],
            "properties": {
              "radar_id": { "type": "string", "minLength": 1 },
              "scan_id": { "type": "string", "format": "uuid" },
              "qc_uri": { "type": "string", "format": "uri" }
            }
          }
        },
        "output_prefix": { "type": "string", "format": "uri" },
        "diagnostic_config_version": { "type": "string", "minLength": 1 },
        "renderer_version": { "type": "string", "minLength": 1 },
        "flag_definition_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
