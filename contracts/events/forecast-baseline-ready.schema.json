{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/forecast-baseline-ready.schema.json",
  "title": "RainPulse forecast.baseline.ready.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "run_id", "job_id", "trace_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "forecast.baseline.ready.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forecast_uri", "issue_time", "grid_id", "model_id", "model_version", "config_version", "lead_count", "lead_step_minutes", "valid_from", "valid_to"],
      "properties": {
        "forecast_uri": { "type": "string", "format": "uri" },
        "issue_time": { "type": "string", "format": "date-time" },
        "grid_id": { "type": "string", "minLength": 1 },
        "model_id": { "const": "pysteps-lk" },
        "model_version": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 },
        "lead_count": { "const": 24 },
        "lead_step_minutes": { "const": 5 },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_to": { "type": "string", "format": "date-time" }
      }
    }
  }
}
