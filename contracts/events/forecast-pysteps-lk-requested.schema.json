{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/forecast-pysteps-lk-requested.schema.json",
  "title": "RainPulse forecast.pysteps_lk.requested.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "run_id", "job_id", "trace_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "forecast.pysteps_lk.requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_uri", "output_prefix", "issue_time", "grid_id", "input_asset_ids", "model_id", "model_version", "config_version", "forecast_contract_version", "baseline_models"],
      "properties": {
        "input_uri": { "type": "string", "format": "uri" },
        "output_prefix": { "type": "string", "format": "uri" },
        "issue_time": { "type": "string", "format": "date-time" },
        "grid_id": { "type": "string", "minLength": 1 },
        "input_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "model_id": { "const": "pysteps-lk" },
        "model_version": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 },
        "forecast_contract_version": { "const": "1.1" },
        "baseline_models": { "const": ["persistence", "translation"] }
      }
    }
  }
}
