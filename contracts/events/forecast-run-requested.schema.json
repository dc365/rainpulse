{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/forecast-run-requested.schema.json",
  "title": "RainPulse forecast.run.requested.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "run_id", "trace_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "forecast.run.requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_uri", "issue_time", "grid_id", "baseline_models", "config_version"],
      "properties": {
        "input_uri": { "type": "string", "format": "uri" },
        "issue_time": { "type": "string", "format": "date-time" },
        "grid_id": { "type": "string", "minLength": 1 },
        "baseline_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["persistence", "translation", "pysteps_lk"] }
        },
        "config_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
