{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/nowcast-input-ready.schema.json",
  "title": "RainPulse nowcast.input.ready.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "run_id", "job_id", "trace_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "nowcast.input.ready.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_uri", "issue_time", "grid_id", "analysis_ids", "frame_count", "timestep_minutes", "valid_coverage_ratio", "mean_quality_index", "max_data_age_minutes", "preprocess_version"],
      "properties": {
        "input_uri": { "type": "string", "format": "uri" },
        "issue_time": { "type": "string", "format": "date-time" },
        "grid_id": { "type": "string", "minLength": 1 },
        "analysis_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "format": "uuid" }
        },
        "frame_count": { "type": "integer", "minimum": 3, "maximum": 6 },
        "timestep_minutes": { "const": 5 },
        "valid_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "mean_quality_index": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_data_age_minutes": { "type": "number", "minimum": 0 },
        "preprocess_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
