{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/product-build-requested.schema.json",
  "title": "RainPulse product.build.requested.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "run_id",
    "job_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "product.build.requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_uri",
        "input_sha256",
        "output_prefix",
        "model_run_id",
        "issue_time",
        "grid_id",
        "model_id",
        "model_version",
        "model_config_version",
        "product_config_version",
        "product_bundle_contract_version",
        "product_ids"
      ],
      "properties": {
        "input_uri": { "type": "string", "format": "uri" },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "output_prefix": { "type": "string", "format": "uri" },
        "model_run_id": { "type": "string", "format": "uuid" },
        "issue_time": { "type": "string", "format": "date-time" },
        "grid_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "model_config_version": { "type": "string", "minLength": 1 },
        "product_config_version": { "type": "string", "minLength": 1 },
        "product_bundle_contract_version": { "const": "1.0" },
        "product_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rain_rate", "accumulation_60", "accumulation_120"],
          "properties": {
            "rain_rate": { "type": "string", "format": "uuid" },
            "accumulation_60": { "type": "string", "format": "uuid" },
            "accumulation_120": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}
