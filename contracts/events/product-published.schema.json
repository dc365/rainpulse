{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/product-published.schema.json",
  "title": "RainPulse product.published event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "run_id",
    "job_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "product.published" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "product_type",
        "model_id",
        "model_version",
        "config_version",
        "grid_id",
        "issue_time",
        "valid_times",
        "assets"
      ],
      "properties": {
        "product_id": { "type": "string", "format": "uuid" },
        "product_type": {
          "type": "string",
          "enum": [
            "rain_rate",
            "accumulation_60",
            "accumulation_120",
            "probability_exceedance",
            "quantile",
            "motion_field",
            "quality"
          ]
        },
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 },
        "grid_id": { "type": "string", "minLength": 1 },
        "issue_time": { "type": "string", "format": "date-time" },
        "valid_times": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "date-time" }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "asset_type", "uri", "sha256", "size_bytes"],
            "properties": {
              "asset_id": { "type": "string", "format": "uuid" },
              "asset_type": { "type": "string", "minLength": 1 },
              "uri": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "media_type": { "type": "string" },
              "lead_time_minutes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
