{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainpulse.local/contracts/events/radar-grid-requested.schema.json",
  "title": "RainPulse radar.grid.requested.v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "run_id", "job_id", "trace_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "radar.grid.requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_id", "radar_id", "input_uri", "output_prefix", "grid_id", "grid_config_version", "hybrid_scan_version"],
      "properties": {
        "scan_id": { "type": "string", "format": "uuid" },
        "radar_id": { "type": "string", "minLength": 1 },
        "input_uri": { "type": "string", "format": "uri" },
        "output_prefix": { "type": "string", "format": "uri" },
        "grid_id": { "type": "string", "minLength": 1 },
        "grid_config_version": { "type": "string", "minLength": 1 },
        "hybrid_scan_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
