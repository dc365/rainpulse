{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "ops.multiband.requested.v1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "x_qc",
            "sx_composite"
          ]
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "network_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Frozen CPU execution policy identity; not a meteorological product policy."
        },
        "analysis_time": {
          "type": "string",
          "format": "date-time"
        },
        "input_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "radar_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "scan_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "input_uri": {
                "type": "string",
                "pattern": "^s3://"
              },
              "volume_start": {
                "type": "string",
                "format": "date-time"
              },
              "volume_end": {
                "type": "string",
                "format": "date-time"
              },
              "available_at": {
                "type": "string",
                "format": "date-time"
              },
              "expected_qc_identity": {
                "$ref": "#/$defs/upstreamQCIdentity"
              }
            },
            "required": [
              "radar_id",
              "scan_id",
              "input_uri",
              "volume_start",
              "volume_end",
              "available_at"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "output_prefix": {
          "type": "string",
          "pattern": "^s3://rainpulse/operations/"
        },
        "analysis_id": {
          "type": "string"
        },
        "scan_id": {
          "type": "string"
        },
        "radar_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "requested_radars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "requested_s_radars": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
          }
        },
        "s_qc_policy": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/sQCRecipe"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "s_qc_policy_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "network_sha256",
        "execution_sha256",
        "analysis_time",
        "input_cutoff",
        "sources",
        "output_prefix",
        "analysis_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sx_composite"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "product_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "product_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "s_qc_policy_complete": {
                "const": true
              }
            },
            "required": [
              "s_qc_policy_complete"
            ]
          },
          "then": {
            "properties": {
              "s_qc_policy": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/completeSQCRecipe"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "requested_s_radars": [
          "s_qc_policy",
          "s_qc_policy_complete"
        ],
        "s_qc_policy": [
          "requested_s_radars",
          "s_qc_policy_complete"
        ],
        "s_qc_policy_complete": [
          "requested_s_radars",
          "s_qc_policy"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "job_id",
    "run_id",
    "trace_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-band managed request. Frozen input markers remain in the existing ops Spec, not in arrays over HTTP.",
  "$defs": {
    "upstreamQCIdentity": {
      "type": "object",
      "properties": {
        "radar_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "scan_id": {
          "type": "string",
          "format": "uuid"
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementation_revision": {
          "type": "string",
          "pattern": "^python-source-tree-v1:[a-f0-9]{64}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "libraries": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "radar_id",
        "scan_id",
        "pipeline_version",
        "profile"
      ],
      "additionalProperties": false
    },
    "sQCRecipe": {
      "type": "object",
      "properties": {
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementation_revision": {
          "type": "string",
          "pattern": "^python-source-tree-v1:[a-f0-9]{64}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "libraries": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "pipeline_version",
        "profile"
      ],
      "additionalProperties": false
    },
    "completeSQCRecipe": {
      "type": "object",
      "properties": {
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementation_revision": {
          "type": "string",
          "pattern": "^python-source-tree-v1:[a-f0-9]{64}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "libraries": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minProperties": 1
        }
      },
      "required": [
        "pipeline_version",
        "profile",
        "parameters_sha256",
        "implementation_revision",
        "libraries"
      ],
      "additionalProperties": false
    }
  }
}
