# Optional release label. Leave empty to expose the commit embedded at build time.
RAINPULSE_VERSION=
RAINPULSE_BIND_ADDRESS=0.0.0.0
RAINPULSE_API_BIND_ADDRESS=127.0.0.1
RAINPULSE_INFRA_BIND_ADDRESS=127.0.0.1
RAINPULSE_API_PORT=8080
RAINPULSE_WEB_PORT=4173
RAINPULSE_POSTGRES_PORT=5432
RAINPULSE_NATS_PORT=4222
RAINPULSE_NATS_MONITOR_PORT=8222
RAINPULSE_MINIO_PORT=9000
RAINPULSE_MINIO_CONSOLE_PORT=9001
RAINPULSE_PROMETHEUS_PORT=9090
RAINPULSE_ALERTMANAGER_PORT=9093
RAINPULSE_MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:9001
RAINPULSE_ALGORITHM_VERIFICATION_HOST_ROOT=../runtime/reports/mrms
RAINPULSE_ENSEMBLE_PRODUCT_HOST_ROOT=../runtime/products/ensemble

# Continuous radar ingest is disabled until a verified operational radar
# configuration and arrival directory are available. The watcher requires the
# same size and mtime on two scans, then archives raw bytes before registration.
RAINPULSE_RADAR_INGEST_ENABLED=false
RAINPULSE_RADAR_INGEST_CONFIG=/opt/rainpulse/configs/radars/z9598.yaml
RAINPULSE_RADAR_INGEST_ROOT=/data/Weather/RADA/FMT_L2_Z959X_SBD
RAINPULSE_RADAR_INGEST_INTERVAL=15s
RAINPULSE_RADAR_INGEST_MIN_AGE=30s
RAINPULSE_RADAR_INGEST_LOOKBACK=24h
RAINPULSE_RADAR_CONFIG_DIR=/opt/rainpulse/configs/radars
RAINPULSE_RADAR_MOSAIC_CONFIG=/opt/rainpulse/configs/mosaic/rp016-qi-mosaic-v1.yaml

# State-driven real-data planner: decode -> QC -> grid -> 5-minute mosaic ->
# QPE -> NowcastInput -> pySTEPS-LK -> application products. It is isolated
# from synthetic workflows by an explicit radar allowlist and grid profile.
RAINPULSE_PIPELINE_ENABLED=false
RAINPULSE_PIPELINE_RADAR_IDS=z9598
RAINPULSE_PIPELINE_INTERVAL=2s
RAINPULSE_PIPELINE_LOOKBACK=1h
RAINPULSE_PIPELINE_MOSAIC_DELAY=2m
RAINPULSE_MAX_INPUT_ARTIFACT_BYTES=2147483648

# Required secrets. Generate high-entropy hexadecimal values and never commit deploy/.env.
RAINPULSE_POSTGRES_PASSWORD=
RAINPULSE_MINIO_ROOT_USER=
RAINPULSE_MINIO_ROOT_PASSWORD=
RAINPULSE_MINIO_WORKER_ACCESS_KEY=
RAINPULSE_MINIO_WORKER_SECRET_KEY=
RAINPULSE_NATS_USER=
RAINPULSE_NATS_PASSWORD=

# Optional for the engineering environment. When empty, all /api/v1/admin routes
# fail closed. Set a high-entropy value only when administrative APIs are needed.
RAINPULSE_ADMIN_TOKEN=
