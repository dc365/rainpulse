# Optional release label. Leave empty to expose the commit embedded at build time.
RAINPULSE_VERSION=
RAINPULSE_BIND_ADDRESS=0.0.0.0
RAINPULSE_API_BIND_ADDRESS=127.0.0.1
RAINPULSE_INFRA_BIND_ADDRESS=127.0.0.1
RAINPULSE_API_PORT=8080
RAINPULSE_WEB_PORT=4173
RAINPULSE_POSTGRES_PORT=5432
RAINPULSE_NATS_PORT=4222
RAINPULSE_NATS_MONITOR_PORT=8222
RAINPULSE_MINIO_PORT=9000
RAINPULSE_MINIO_CONSOLE_PORT=9001
RAINPULSE_PROMETHEUS_PORT=9090
RAINPULSE_ALERTMANAGER_PORT=9093
RAINPULSE_MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:9001
RAINPULSE_ALGORITHM_VERIFICATION_HOST_ROOT=../runtime/reports/mrms
RAINPULSE_ENSEMBLE_PRODUCT_HOST_ROOT=../runtime/products/ensemble

# Legacy single-source watcher. Keep disabled when the RP-041 multi-source
# radar-ingest service is enabled through docker-compose.realtime-shadow.yaml.
RAINPULSE_RADAR_INGEST_ENABLED=false
RAINPULSE_RADAR_INGEST_CONFIG=/opt/rainpulse/configs/radars/z9598.yaml
RAINPULSE_RADAR_INGEST_ROOT=/data/Weather/RADA/FMT_L2_Z959X_SBD
RAINPULSE_RADAR_INGEST_INTERVAL=15s
RAINPULSE_RADAR_INGEST_MIN_AGE=30s
RAINPULSE_RADAR_INGEST_LOOKBACK=24h
RAINPULSE_RADAR_CONFIG_DIR=/opt/rainpulse/configs/radars
RAINPULSE_RADAR_MOSAIC_CONFIG=/opt/rainpulse/configs/mosaic/rp016-qi-mosaic-v1.yaml

# RP-041 dedicated four-source ingest and UI projection. The Compose override
# supplies these values inside containers; expose them here for non-Compose runs.
RAINPULSE_RADAR_INGEST_MANIFEST=/opt/rainpulse/configs/ingest/fujian-realtime-shadow-v1.json
RAINPULSE_INGEST_HEALTH_ADDR=:8092
RAINPULSE_INGEST_STATUS_URL=http://radar-ingest:8092/status
RAINPULSE_WORKSPACE_EXECUTION_MODE=realtime_shadow
RAINPULSE_NOWCASTNET_SHADOW_STATUS_URL=http://nowcastnet-shadow-probe:8094/status
RAINPULSE_NOWCASTNET_SHADOW_CONFIG=/opt/rainpulse/configs/nowcast/fujian-nowcastnet-shadow-v1.yaml
RAINPULSE_ANALYSIS_CATALOG_URL=http://api:8080/api/v1/analysis-cycles?status=ANALYSIS_READY&limit=200
RAINPULSE_NOWCASTNET_SHADOW_INTERVAL_SECONDS=30

# State-driven real-data planner: decode -> QC -> grid -> waterline mosaic ->
# QPE -> NowcastInput -> pySTEPS-LK -> application products. realtime_shadow
# accepts draft Fujian configuration but never grants operational eligibility.
RAINPULSE_PIPELINE_ENABLED=false
RAINPULSE_PIPELINE_MODE=realtime_shadow
RAINPULSE_PIPELINE_RADAR_IDS=z9591,z9593,z9598,z9599
RAINPULSE_PIPELINE_INTERVAL=2s
RAINPULSE_PIPELINE_LOOKBACK=2h
RAINPULSE_PIPELINE_MOSAIC_DELAY=30s
RAINPULSE_PIPELINE_MOSAIC_MAX_WAIT=4m
RAINPULSE_PIPELINE_FORECAST_ENABLED=true
RAINPULSE_PIPELINE_REQUIRE_ALL_RADARS=false
RAINPULSE_PIPELINE_QC_CONFIG=/opt/rainpulse/configs/qc/rp040-fujian-radial-v3.yaml
RAINPULSE_PIPELINE_GRID_CONFIG=/opt/rainpulse/configs/gridding/rp040-hybrid-qc-v3.yaml
RAINPULSE_PIPELINE_MOSAIC_CONFIG=/opt/rainpulse/configs/mosaic/rp041-fujian-realtime-shadow-v1.yaml
RAINPULSE_PIPELINE_QPE_CONFIG=/opt/rainpulse/configs/qpe/rp011-basic-zr-v1.yaml
RAINPULSE_PIPELINE_DIAGNOSTIC_CONFIG=/opt/rainpulse/configs/diagnostics/rp012-operational-diagnostics-v1.yaml
RAINPULSE_PIPELINE_NOWCAST_INPUT_CONFIG=/opt/rainpulse/configs/nowcast/rp041-realtime-shadow-5min-v1.yaml
RAINPULSE_PIPELINE_PYSTEPS_CONFIG=/opt/rainpulse/configs/nowcast/rp016-pysteps-lk-v1.yaml
RAINPULSE_PIPELINE_PRODUCT_CONFIG=/opt/rainpulse/configs/products/rp015-application-products-v1.yaml
RAINPULSE_PIPELINE_VERIFICATION_CONFIG=/opt/rainpulse/configs/verification/rp031-operational-deterministic-v1.yaml
RAINPULSE_MAX_INPUT_ARTIFACT_BYTES=2147483648

# Required secrets. Generate high-entropy hexadecimal values and never commit deploy/.env.
RAINPULSE_POSTGRES_PASSWORD=
RAINPULSE_MINIO_ROOT_USER=
RAINPULSE_MINIO_ROOT_PASSWORD=
RAINPULSE_MINIO_WORKER_ACCESS_KEY=
RAINPULSE_MINIO_WORKER_SECRET_KEY=
RAINPULSE_NATS_USER=
RAINPULSE_NATS_PASSWORD=

# Optional for the engineering environment. When empty, all /api/v1/admin routes
# fail closed. Set a high-entropy value only when administrative APIs are needed.
RAINPULSE_ADMIN_TOKEN=
