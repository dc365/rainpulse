# 部署入口。相对路径以 deploy/ 为基准；详细说明见 deploy/README.md。
# 复制为 deploy/.env，填写凭据。算法配置、容器地址、调优参数沿用 Compose 默认值。

# Web 访问端口；API 和基础设施默认仅监听 127.0.0.1。
RAINPULSE_WEB_PORT=4173

# Ruiyun BDP：105 使用 /home/yons/hwapp/ruiyun-bdp/conf。
# required 要求配置中心与元数据可用；独立运行可改为 off。
RAINPULSE_BDP_MODE=required
RAINPULSE_BDP_CONFIG_CODE=bdp-dp-rada-rainpulse
RAINPULSE_BDP_CONF_HOST_ROOT=../../../conf

# 宿主机雷达目录，同路径只读挂载到容器，必须覆盖 RADA_L2_FMT 元数据解析的路径。
# 这是文件访问权限的挂载边界，实际采集路径由 BDP 元数据决定。
RAINPULSE_RADAR_DATA_ROOT=/data/Weather/RADA/RADA_L2_FMT/OBS_TEMP

# 必填凭据。使用随机高强度值，禁止提交 deploy/.env。
RAINPULSE_POSTGRES_PASSWORD=
RAINPULSE_MINIO_ROOT_USER=
RAINPULSE_MINIO_ROOT_PASSWORD=
RAINPULSE_MINIO_WORKER_ACCESS_KEY=
RAINPULSE_MINIO_WORKER_SECRET_KEY=
RAINPULSE_NATS_USER=
RAINPULSE_NATS_PASSWORD=

# 启用界面手动重算时填写；Web 网关代传，浏览器用户不需要输入。
RAINPULSE_ADMIN_TOKEN=

# C3 可选影子切换：planner 与 analysis-qpe-worker 同步指向新 QPE profile。
# 示例容器内路径：configs/qpe/rp017-stratiform-vpr-v1.yaml
# RAINPULSE_PIPELINE_QPE_CONFIG=configs/qpe/rp017-stratiform-vpr-v1.yaml
# RAINPULSE_QPE_CONFIG=configs/qpe/rp017-stratiform-vpr-v1.yaml
# RAINPULSE_QC_FLAG_DEFINITIONS=configs/qc/flag-definitions.yaml
RAINPULSE_PIPELINE_QPE_CONFIG=
RAINPULSE_QPE_CONFIG=
RAINPULSE_QC_FLAG_DEFINITIONS=
